{
  "name": "doc-extractor",
  "version": "0.1.0",
  "description": "Extract structured content from .docx files into a clean JSON IR for downstream LLM processing.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "doc-extract": "./bin/extract.js"
  },
  "scripts": {
    "extract": "node bin/extract.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src bin test",
    "format": "prettier --write src bin test",
    "fixtures:generate": "node test/fixtures/generate.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.0.0",
    "mammoth": "^1.8.0"
  },
  "devDependencies": {
    "docx": "^9.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "vitest": "^2.1.0"
  }
}
